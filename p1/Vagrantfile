Vagrant.configure("2") do |config|
    config.vm.box = "generic/ubuntu2204"
    
    config.vm.provider "libvirt" do |lv|
        lv.cpus = 1
        lv.memory = 1024
        lv.driver = "kvm"
        lv.disk_bus = "virtio"
        lv.nic_model_type = "virtio"
    end

    config.vm.define "pcheronS" do |s|
        s.vm.hostname = "pcheronS"
        s.vm.network "private_network", ip: "192.168.56.110"
        s.vm.provision "shell", path: "scripts/server.sh", args: ["pcheron"]
    end

    config.vm.define "pcheronSW" do |w|
        w.vm.hostname = "pcheronSW"
        w.vm.network "private_network", ip: "192.168.56.111"
        w.vm.provision "shell", path: "scripts/agent.sh"
    end
end