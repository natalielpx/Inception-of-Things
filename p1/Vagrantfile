# -*- mode: ruby -*-
# vi: set ft=ruby :

SERVER		= "nlamS"
SERVER_IP	= "192.168.56.110"
AGENT			= "nlamSW"
AGENT_IP	= "192.168.56.111"
K3S_VERS	= "v1.31.4+k3s1"

# Vagrant configuration
Vagrant.configure("2") do |config|

	# Global configurations (applied across all machines)
	# config.vm.box = "generic/debian12"
	# config.vm.box_version = "4.3.12"
	# config.vm.provider "libvirt" do |lv|
	config.vm.box = "bento/debian-12"
	config.vm.provider "vmware_desktop" do |lv|
		lv.cpus = 1
		lv.memory = 1024
	end

	# Machine 1: Server
	config.vm.define SERVER do |server|
		server.vm.hostname = SERVER
		server.vm.network "private_network", ip: SERVER_IP
	end

	# Machine 2: Server Worker
	config.vm.define AGENT do |agent|
		agent.vm.hostname = AGENT
		agent.vm.network "private_network", ip: AGENT_IP
		# Provision both machines via Ansible
		agent.vm.provision "ansible" do |ansible|
			ansible.playbook = "p1.yml"
			ansible.limit = "all"
			ansible.groups = {
				"k3s_cluster" => [SERVER, AGENT],
				"server" => [SERVER],
				"agent" => [AGENT]
			}
			ansible.extra_vars = {
				k3s_version: K3S_VERS,
				api_endpoint: SERVER_IP
			}
		end
	end
end
